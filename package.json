{
  "name": "repositorio-sife-extremadura",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "import:master-report": "node scripts/import-master-report.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:knowledge": "node scripts/build-knowledge.mjs",
    "validate": "node scripts/validate-data.mjs",
    "check:links": "node scripts/check-links.mjs",
    "dev": "node scripts/build-data.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build-knowledge.mjs && node scripts/build-data.mjs && node scripts/validate-data.mjs && tsc -b && vite build",
    "build:web": "node scripts/validate-data.mjs --web && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "wrangler": "^4.128.0"
  }
}
